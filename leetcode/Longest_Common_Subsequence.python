class Solution(object):
    def longestCommonSubsequence(self, text1, text2):
        dp={}

        def rec(i,j):
            if i == len(text1) or j == len(text2):
                return 0
            if (i, j) in dp:
                return dp[(i, j)]

            if text1[i]==text2[j]:
                dp[(i,j)]=1+rec(i+1, j+1)
            
            else:
                dp[(i, j)] = max(rec(i + 1, j), rec(i, j + 1))
            
            return dp[(i,j)]
            
        return rec(0,0)