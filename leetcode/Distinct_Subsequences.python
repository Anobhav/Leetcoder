class Solution(object):
    def numDistinct(self, s, t):
        dp = {}

        def rec(i, j):
            # We have successfully formed all of t
            if j == len(t):
                return 1

            # s is exhausted but t is not
            if i == len(s):
                return 0

            if (i, j) in dp:
                return dp[(i, j)]

            if s[i] == t[j]:
                dp[(i, j)] = rec(i + 1, j + 1) + rec(i + 1, j)
            else:
                dp[(i, j)] = rec(i + 1, j)

            return dp[(i, j)]

        return rec(0, 0)