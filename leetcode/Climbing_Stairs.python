class Solution(object):
    def climbStairs(self, n):
        memo = {}

        def rec(n):
            if n == 0:
                return 1

            if n == 1:
                return 1

            if n in memo:
                return memo[n]

            memo[n] = rec(n-1) + rec(n-2)
            return memo[n]

        return rec(n)