class Solution(object):
    def rob(self, nums):

        if len(nums) == 1:
            return nums[0]

        def linear_rob(arr):
            if len(arr) == 1:
                return arr[0]

            p2 = arr[0]
            p1 = max(arr[0], arr[1])

            for i in range(2, len(arr)):
                amt = max(p1, p2 + arr[i])
                p2 = p1
                p1 = amt

            return p1

        case1 = linear_rob(nums[:-1])
        case2 = linear_rob(nums[1:])

        return max(case1, case2)