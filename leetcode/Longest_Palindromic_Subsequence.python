class Solution(object):
    def longestPalindromeSubseq(self, s):
        dp={}

        def rec(i,j):
            if i>j:
                return 0
            if i==j:
                return 1
            if (i,j) in dp:
                return dp[(i,j)]

            if s[i] == s[j]:
                dp[(i, j)] = 2 + rec(i + 1, j - 1)

            else:
                dp[(i, j)] = max(rec(i + 1, j), rec(i, j - 1))

            return dp[(i, j)]               

        return rec(0,len(s)-1)