class Solution(object):
    def maxArea(self, height):
        ans=0
        left=0
        right=len(height)-1

        while(left<right):
            temp=min(height[left],height[right])*(right-left)
            ans=max(ans,temp)

            if height[left]<height[right]:
                left+=1
            else:
                right-=1

        return ans   