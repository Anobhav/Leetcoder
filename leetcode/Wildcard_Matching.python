class Solution(object):
    def isMatch(self, s, p):
        dp = {}
        p = re.sub(r'\*+', '*', p)

        def rec(i, j):
            if i == len(s):
                while j < len(p):
                    if p[j] != '*':
                        return False
                    j += 1
                return True

            if j == len(p):
                return False

            if (i, j) in dp:
                return dp[(i, j)]

            if s[i] == p[j] or p[j] == '?':
                dp[(i, j)] = rec(i + 1, j + 1)

            elif p[j] == '*':
                dp[(i, j)] = rec(i, j + 1) or rec(i + 1, j)

            else:
                dp[(i, j)] = False

            return dp[(i, j)]

        return rec(0, 0)