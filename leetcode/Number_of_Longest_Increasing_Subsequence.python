class Solution(object):
    def findNumberOfLIS(self, nums):
        n = len(nums)

        dp = [1] * n
        count = [1] * n

        for i in range(n):
            for j in range(i):
                if nums[j] < nums[i]:

                    if dp[j] + 1 > dp[i]:
                        dp[i] = dp[j] + 1
                        count[i] = count[j]

                    elif dp[j] + 1 == dp[i]:
                        count[i] += count[j]

        max_length = max(dp)

        ans = 0

        for i in range(n):
            if dp[i] == max_length:
                ans += count[i]

        return ans