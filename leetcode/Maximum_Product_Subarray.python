class Solution(object):
    def maxProduct(self, nums):
        maxdp=[0]*len(nums)
        maxdp[0]=nums[0]

        mindp=[0]*len(nums)
        mindp[0]=nums[0]

        for i in range(1,len(nums)):
            maxdp[i]=max(nums[i],maxdp[i-1]*nums[i],mindp[i-1]*nums[i])
            mindp[i]=min(nums[i],mindp[i-1]*nums[i],maxdp[i-1]*nums[i])
        return max(maxdp)