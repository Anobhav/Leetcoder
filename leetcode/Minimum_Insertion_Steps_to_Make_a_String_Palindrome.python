class Solution(object):
    def minInsertions(self, s):
        dp={}

        def rec(i,j):

            if i>=j:
                return 0
            if (i,j) in dp:
                return dp[(i,j)]
            if s[i]==s[j]:
                dp[(i,j)]=(rec(i+1,j-1))
            else:
                dp[(i,j)]=1+min(rec(i+1,j),rec(i,j-1))
            
            return dp[(i,j)]
        
        return rec(0,len(s)-1)