class Solution(object):
    def maxProfit(self, prices):
        mbp=prices[0]
        profit=0
        for i in range(1,len(prices)):
            if prices[i]<mbp:
                mbp=prices[i]
            
            else:
                currentprofit=prices[i]-mbp
                profit=max(profit,currentprofit)
        
        return profit